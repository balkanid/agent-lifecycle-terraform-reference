# Copy to .env and fill. Never commit .env.

# BalkanID Public API for your tenant (local, sandbox, or customer dev)
BALKANID_PUBLIC_API_URL=https://your-tenant.balkanid.app/api/public

# Employee API key (BalkanID UI → profile menu → API Keys)
API_KEY_ID=
API_KEY_SECRET=

# Agent owner — employee who will own the agent (must exist in the tenant)
AGENT_OWNER_EMAIL=

# Optional: integration id associated with the agent (e.g. AWS)
INTEGRATION_ID=

# Agent metadata for createRequest (AGENT_ACCESS)
AGENT_NAME=demo-support-agent
AGENT_TYPE=terraform
AGENT_PURPOSE=Internal support assistant provisioned via Terraform
# Optional: expected IAM role ARN after Terraform creates the Bedrock execution role
INTENDED_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/balkanid-agent-lifecycle/demo-support-agent

# Gate polling
POLL_SECONDS=5
# Max seconds to wait for approval before failing (local default 15 min; CD workflow uses approval_wait_minutes)
POLL_TIMEOUT_SECONDS=900
