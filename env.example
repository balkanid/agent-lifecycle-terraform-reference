# Copy to .env and fill. Never commit .env.

# BalkanID Public API URL (tenant is determined by your API key)
BALKANID_PUBLIC_API_URL=https://your-tenant.balkanid.app/api/public

# Employee API key (BalkanID UI → profile menu → API Keys)
API_KEY_ID=
API_KEY_SECRET=

# Agent owner — employee who will own the agent (must exist in your tenant)
BALKANID_AGENT_OWNER_EMAIL=

# Optional: integration id associated with the agent (e.g. AWS) — required for post-apply sync
INTEGRATION_ID=

# After Terraform creates AWS agent resources, call Public API syncIntegration (requires INTEGRATION_ID)
TRIGGER_INTEGRATION_SYNC=true

# Agent metadata for createRequest (AGENT_ACCESS)
AGENT_NAME=demo-support-agent
# agentcore (default, new AWS accounts) or classic (Bedrock Agents Classic, allowlisted accounts only)
AGENT_BACKEND=agentcore
AGENT_TYPE=terraform
AGENT_PURPOSE="Support assistant provisioned via Terraform with BalkanID approval"
# Optional: expected IAM role ARN after Terraform creates the Bedrock execution role
INTENDED_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/balkanid-agent-lifecycle/demo-support-agent

# AWS credentials for local Terraform apply-bedrock (IAM user with aws/bedrock-agent-lifecycle-iam-policy.json)
# GitHub CD uses secrets AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY on the agent-lifecycle environment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1

# Optional: path to aws CLI if `aws` is not on PATH
# AWS_CLI=

# Gate polling
POLL_SECONDS=5
# Max seconds to wait for approval before failing (local default 15 min; CD uses APPROVAL_WAIT_MINUTES)
POLL_TIMEOUT_SECONDS=900

# --- Service account gate (CREATE_SERVICE_ACCOUNT) ---
# Set SERVICE_ACCOUNT_GATE=true in CD, or use apply-lifecycle locally (runs both gates).
SERVICE_ACCOUNT_GATE=false
SERVICE_ACCOUNT_ROLE_NAME=demo-support-agent
# Policy reviewed on the create request (grants in scimPayload)
SERVICE_ACCOUNT_POLICY_NAME=AmazonBedrockFullAccess
# Optional: policy entity id when name alone is ambiguous
# SERVICE_ACCOUNT_POLICY_ID=
# AGENT_GATE=true is the default in CD for the agent access gate (gate.py)

# --- Which flow the shared scripts serve (gate.py, service_account_gate.py, preflight.py) ---
# bedrock (default: the CI gate above) | bedrock-guardrails (set by scripts/lifecycle.sh) | copilot
# LIFECYCLE_TARGET=bedrock

# --- AWS developer-agent guardrails (scripts/lifecycle.sh; agent name is its argument) ---
# Hours until the agent is torn down (policies/guardrails.json caps this)
# AGENT_TTL_HOURS=8
# Policy names reviewed on the BalkanID requests (no admin or *FullAccess policies)
# AGENT_POLICY_NAMES=AmazonBedrockLimitedAccess
# Matching ARNs attached by Terraform, comma separated; must name exactly AGENT_POLICY_NAMES
# AGENT_POLICY_ARNS=arn:aws:iam::aws:policy/AmazonBedrockLimitedAccess
# Subagent only: the parent agent (child shares the parent's permissions boundary)
# PARENT_AGENT=
# FOUNDATION_MODEL=amazon.nova-micro-v1:0
# Leave empty. Reusing a developer or any existing role is refused by policy_check.py.
# EXISTING_EXECUTION_ROLE_ARN=
# Recorded as requested_by when not running in GitHub Actions
# BALKANID_DEVELOPER_ID=

# --- Microsoft Copilot Studio (LIFECYCLE_TARGET=copilot; not yet run against a live tenant) ---
# AGENT_TYPE=copilot-studio
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=
# POWER_PLATFORM_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000000
# DATAVERSE_ORG_URL=https://contoso.crm.dynamics.com
# SOLUTION_ZIP_PATH=./build/BalkanIDAgentLifecycle_managed.zip
# SOLUTION_UNIQUE_NAME=BalkanIDAgentLifecycle
# SOLUTION_VERSION=1.0.0.0
# AGENT_SCHEMA_NAME=bkn_trialintake
# AGENT_BOT_ID=
# PAC_CLI=pac
# ENTRA_IDENTITY_GATE=false        # also gate the agent's Entra identity
# PROVISION_AGENT_IDENTITY=false   # create it with terraform/entra-agent-identity
# ENTRA_GRAPH_PERMISSIONS=Sites.Selected
# PROVISION_COPILOT_AGENT=false
# PUBLISH_AGENT=false
# VERIFY_APPROVED_SCOPE=true

# --- API client tuning (defaults shown) ---
# GQL_MAX_RETRIES=5
# GQL_RETRY_BACKOFF_SECONDS=2
# GQL_TIMEOUT_SECONDS=120
# BALKANID_SKIP_DOTENV=false       # tests and CI: ignore .env
