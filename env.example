# Copy to .env and fill. Never commit .env.

# Platform Public API URL (tenant comes from the API key, not the hostname)
# Dev: https://balkanid.dev/api/public  Local: https://local.balkan.id/api/public
BALKANID_PUBLIC_API_URL=https://balkanid.dev/api/public

# Employee API key (BalkanID UI → profile menu → API Keys)
API_KEY_ID=
API_KEY_SECRET=

# Agent owner — employee who will own the agent (must exist in the tenant)
BALKANID_AGENT_OWNER_EMAIL=

# Optional: integration id associated with the agent (e.g. AWS) — required for post-apply sync
INTEGRATION_ID=

# After Terraform creates AWS agent resources, call Public API syncIntegration (requires INTEGRATION_ID)
TRIGGER_INTEGRATION_SYNC=true

# Agent metadata for createRequest (AGENT_ACCESS)
AGENT_NAME=demo-support-agent
# agentcore (default, new AWS accounts) or classic (Bedrock Agents Classic, allowlisted accounts only)
AGENT_BACKEND=agentcore
AGENT_TYPE=terraform
AGENT_PURPOSE="Internal support assistant provisioned via Terraform"
# Optional: expected IAM role ARN after Terraform creates the Bedrock execution role
INTENDED_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/balkanid-agent-lifecycle/demo-support-agent

# AWS credentials for local Terraform when enable_bedrock=true (IAM user with aws/bedrock-agent-lifecycle-iam-policy.json)
# GitHub CD uses secrets AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY on the agent-lifecycle environment.
# Pass these as -var / TF_VAR_aws_* to terraform apply (explicit keys avoid broken ~/.aws/config profiles).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1

# Gate polling
POLL_SECONDS=5
# Max seconds to wait for approval before failing (local default 15 min; CD workflow uses approval_wait_minutes)
POLL_TIMEOUT_SECONDS=900
