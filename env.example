# Copy to .env and fill. Never commit .env.

# BalkanID Public API URL (tenant is determined by your API key)
BALKANID_PUBLIC_API_URL=https://your-tenant.balkanid.app/api/public

# Employee API key (BalkanID UI → profile menu → API Keys)
API_KEY_ID=
API_KEY_SECRET=

# Agent owner — employee who will own the agent (must exist in your tenant)
BALKANID_AGENT_OWNER_EMAIL=

# Optional: integration id associated with the agent (e.g. AWS) — required for post-apply sync
INTEGRATION_ID=

# After Terraform creates AWS agent resources, call Public API syncIntegration (requires INTEGRATION_ID)
TRIGGER_INTEGRATION_SYNC=true

# Agent metadata for createRequest (AGENT_ACCESS)
AGENT_NAME=demo-support-agent
# agentcore (default, new AWS accounts) or classic (Bedrock Agents Classic, allowlisted accounts only)
AGENT_BACKEND=agentcore
AGENT_TYPE=terraform
AGENT_PURPOSE="Support assistant provisioned via Terraform with BalkanID approval"
# Optional: expected IAM role ARN after Terraform creates the Bedrock execution role
INTENDED_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/balkanid-agent-lifecycle/demo-support-agent

# AWS credentials for local Terraform apply-bedrock (IAM user with aws/bedrock-agent-lifecycle-iam-policy.json)
# GitHub CD uses secrets AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY on the agent-lifecycle environment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ACCOUNT_ID=
AWS_REGION=us-east-1

# Optional: path to aws CLI if `aws` is not on PATH
# AWS_CLI=

# Gate polling
POLL_SECONDS=5
# Max seconds to wait for approval before failing (local default 15 min; CD uses APPROVAL_WAIT_MINUTES)
POLL_TIMEOUT_SECONDS=900

# --- Service account gate (CREATE_SERVICE_ACCOUNT) ---
# Set SERVICE_ACCOUNT_GATE=true in CD, or use apply-lifecycle locally (runs both gates).
SERVICE_ACCOUNT_GATE=false
SERVICE_ACCOUNT_ROLE_NAME=demo-support-agent
# Policy reviewed on the create request (grants in scimPayload)
SERVICE_ACCOUNT_POLICY_NAME=AmazonBedrockFullAccess
# Optional: policy entity id when name alone is ambiguous
# SERVICE_ACCOUNT_POLICY_ID=
# AGENT_GATE=true is the default in CD for the agent access gate (gate.py)
